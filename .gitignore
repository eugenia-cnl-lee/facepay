# Python virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]

# Environment variables
.env

# VS Code workspace settings (optional)
.vscode/

# macOS files
.DS_Store

# Windows thumbnail cache
Thumbs.db

# Face data — never committed.
# Enrolled faces are personal biometric data; the LFW test set is regenerated
# by running build_dataset.py. Repos hold code, not data.
known/
test/

# Transient webcam capture
scan.jpg

# Downloaded model asset (re-fetched on first run of liveness.py)
face_landmarker.task

# Encrypted template store and its key — NEVER commit
# (the key decrypts biometric templates; the DB holds them)
faces.db
facepay.key

# Wallet / financial data — never committed
wallet.db